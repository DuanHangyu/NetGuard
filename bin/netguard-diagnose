#!/bin/zsh
# NetGuard 诊断：短时间加载真实的 NetGuard 规则（拦截规则带 PF 日志），
# 测试 TUN 与系统代理两条路径，记录被拦截的数据包，然后【总是】自动恢复。
# 不修改 Clash Verge、系统代理或 DNS 设置。
set -u
umask 077

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd -P)"
RUBY=/usr/bin/ruby
CLI="$ROOT_DIR/bin/netguard"
PF_CONF=/etc/pf.conf
ANCHOR_FILE=/etc/pf.anchors/com.netguard
PROBE_GAP=${NETGUARD_DIAG_GAP:-15}
TEST_URL=https://www.google.com/generate_204
PROXY=http://127.0.0.1:7897

if [[ "$(id -u)" -ne 0 || -z "${SUDO_USER:-}" ]]; then
  print -u2 "请运行：sudo $0"
  exit 1
fi
USER_HOME="$(/usr/bin/dscl . -read "/Users/$SUDO_USER" NFSHomeDirectory | /usr/bin/awk '{print $2}')"
export NETGUARD_HOME="$USER_HOME/.netguard"
STAMP="$(date +%Y%m%d-%H%M%S)"
LOG="$NETGUARD_HOME/diagnose-$STAMP.log"
BACKUP="$NETGUARD_HOME/backups/diag-$STAMP"
PFLOG_TXT="$(mktemp -t netguard-pflog)"
/bin/mkdir -p "$BACKUP"
: > "$LOG"

log() { print -r -- "$*" | /usr/bin/tee -a "$LOG"; }

if /usr/bin/grep -q 'com.netguard' "$PF_CONF"; then
  log "NetGuard 保护当前已在运行；请先在 App 里点“停止并恢复网络”，再运行诊断。"
  exit 1
fi

timed() { # timed <label> <command...>
  local label="$1" out
  shift
  out="$("$@" 2>&1 | /usr/bin/tr '\n' ' ' | /usr/bin/cut -c1-160)"
  log "  $label: ${out:-（无输出）}"
}

probe() {
  log ""
  log "== $1 （t=${SECONDS}s）"
  timed "TUN 路径 google      " /usr/bin/curl -sS -o /dev/null -m 8 -w '%{http_code} %{time_total}s' "$TEST_URL"
  timed "系统代理路径 google  " /usr/bin/curl -sS -o /dev/null -m 8 -x "$PROXY" -w '%{http_code} %{time_total}s' "$TEST_URL"
  timed "用户身份 系统代理    " /usr/bin/sudo -u "$SUDO_USER" /usr/bin/curl -sS -o /dev/null -m 8 -x "$PROXY" -w '%{http_code} %{time_total}s' "$TEST_URL"
  timed "系统代理路径 baidu   " /usr/bin/curl -sS -o /dev/null -m 8 -x "$PROXY" -w '%{http_code} %{time_total}s' https://www.baidu.com
  timed "TUN 路径出口 IP      " /usr/bin/curl -sS -m 8 https://api.ipify.org
  timed "系统 DNS example.com " /usr/bin/dig +short +time=3 +tries=1 example.com
  local pid
  pid="$(/usr/bin/pgrep -x verge-mihomo | /usr/bin/head -1)"
  if [[ -n "$pid" ]]; then
    log "  verge-mihomo 对外 TCP 连接（状态 远端，计数）："
    /usr/sbin/lsof -nP -a -p "$pid" -iTCP 2>/dev/null | /usr/bin/awk 'NR>1 && $NF !~ /LISTEN/ {print $(NF), $(NF-1)}' \
      | /usr/bin/sed -E 's/^\((.*)\) /\1 /; s/[^ ]*->//' | /usr/bin/sort | /usr/bin/uniq -c | /usr/bin/sort -rn | /usr/bin/head -15 \
      | while read -r line; do log "    $line"; done
  fi
}

PF_WAS_ENABLED=0
/sbin/pfctl -s info 2>/dev/null | /usr/bin/grep -q 'Status: Enabled' && PF_WAS_ENABLED=1
/bin/cp "$PF_CONF" "$BACKUP/pf.conf"

RESTORED=""
TCPDUMP_PID=""
restore() {
  [[ -n "$RESTORED" ]] && return
  RESTORED=1
  [[ -n "$TCPDUMP_PID" ]] && kill "$TCPDUMP_PID" 2>/dev/null
  /bin/cp "$BACKUP/pf.conf" "$PF_CONF"
  /sbin/pfctl -a com.netguard -F all >/dev/null 2>&1
  /bin/rm -f "$ANCHOR_FILE"
  /sbin/pfctl -f "$PF_CONF" >/dev/null 2>&1
  [[ "$PF_WAS_ENABLED" -eq 0 ]] && /sbin/pfctl -d >/dev/null 2>&1
  log ""
  log "== 已恢复：/etc/pf.conf 还原为诊断前副本，NetGuard 规则已移除。"
  /usr/sbin/chown "$SUDO_USER" "$LOG" 2>/dev/null
}
trap restore EXIT
trap 'exit 130' INT TERM HUP

log "NetGuard 诊断 $STAMP（PF 原状态：$([[ $PF_WAS_ENABLED -eq 1 ]] && print 启用 || print 未启用)）"
log "系统代理：$(/usr/sbin/scutil --proxy | /usr/bin/awk '/HTTPSEnable|HTTPSProxy|HTTPSPort/ {printf "%s=%s ", $1, $3}')"
log "TUN：$(/sbin/ifconfig | /usr/bin/awk '/^utun/ {i=$1} /inet 198\.18\./ {print i}' | /usr/bin/tr '\n' ' ')"

probe "基线（NetGuard 未启用）"

RULES="$("$RUBY" "$CLI" plan 2>>"$LOG")"
if [[ $? -ne 0 || -z "$RULES" ]]; then
  log "生成规则失败，未修改 PF。"
  exit 1
fi
RULES="${RULES//block out /block out log }"
log ""
log "== 诊断用规则（拦截规则附加 log）："
print -r -- "$RULES" | /usr/bin/sed 's/^/  /' >> "$LOG"

/sbin/ifconfig pflog0 >/dev/null 2>&1 || /sbin/ifconfig pflog0 create
/usr/sbin/tcpdump -n -e -tttt -l -i pflog0 > "$PFLOG_TXT" 2>/dev/null &
TCPDUMP_PID=$!

print -r -- "$RULES" > "$ANCHOR_FILE"
/bin/chmod 0600 "$ANCHOR_FILE"
print -r -- $'\n# NetGuard managed lines\nanchor "com.netguard"\nload anchor "com.netguard" from "/etc/pf.anchors/com.netguard"' >> "$PF_CONF"
if ! /sbin/pfctl -f "$PF_CONF" >>"$LOG" 2>&1; then
  log "PF 加载失败，立即恢复。"
  exit 1
fi
/sbin/pfctl -E >/dev/null 2>&1
log ""
log ">>> NetGuard 规则已加载（此期间整机可能断网，结束后自动恢复）"
SECONDS=0

sleep 3
probe "启用后 #1"
sleep "$PROBE_GAP"
probe "启用后 #2"
sleep "$PROBE_GAP"
probe "启用后 #3"

log ""
log "== 规则命中计数："
/sbin/pfctl -a com.netguard -vsr 2>&1 | /usr/bin/grep -v -E "ALTQ" | /usr/bin/sed "s/^/  /" >> "$LOG"

restore
sleep 1
log ""
log "== 被拦截的数据包（按 接口 → 目标 汇总，前 30）："
/usr/bin/sed -nE 's/.*(block out on [^:]+): ([^ ]+) > ([^:]+):.*/\1 \3/p' "$PFLOG_TXT" \
  | /usr/bin/sed -E 's/\.([0-9]+)$/:\1/' | /usr/bin/sort | /usr/bin/uniq -c | /usr/bin/sort -rn | /usr/bin/head -30 \
  | while read -r line; do log "  $line"; done
log "  （共 $(/usr/bin/wc -l < "$PFLOG_TXT" | /usr/bin/tr -d ' ') 条 PF 日志）"
/bin/rm -f "$PFLOG_TXT"
/usr/sbin/chown "$SUDO_USER" "$LOG"
log ""
log "诊断完成，日志：$LOG"
