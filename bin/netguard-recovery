#!/bin/sh
# Local recovery: no DNS, network or third-party dependency is required.
set -eu
if [ "$(id -u)" -ne 0 ]; then
  echo '请运行：sudo /Users/qing/Projects/NetGuard/bin/netguard-recovery' >&2
  exit 1
fi
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec /usr/bin/ruby "$SCRIPT_DIR/netguard" recovery
